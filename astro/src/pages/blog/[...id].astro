---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { formatDate, getPosts } from "../../lib/posts";
import { profile } from "../../data/site";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} · Edesem`} description={post.data.description}>
	<Header />
	<main class="wrap">
		<article>
			<a class="back" href="/#blog">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square">
					<path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" />
				</svg>
				Blog
			</a>
			<header>
				<h1>{post.data.title}</h1>
				<p class="meta">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				</p>
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>
	</main>

	<footer>
		<div class="wrap foot">
			<p>Edesem</p>
			<a href={profile.github} rel="me noopener" target="_blank">github.com/edesem</a>
		</div>
	</footer>
</Layout>

<style>
	article {
		max-width: 42rem;
		margin-inline: 0;
		padding-top: clamp(2rem, 5vw, 3.5rem);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		font-family: var(--font-cond);
		font-weight: 500;
		font-size: 1.0625rem;
		color: var(--ink-soft);
		text-underline-offset: 0.35em;
	}

	h1 {
		margin-top: 1rem;
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.1;
	}

	.meta {
		margin-top: 0.75rem;
		font-family: var(--font-cond);
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.prose {
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: var(--rule);
	}

	.prose :global(> * + *) {
		margin-top: 1.1rem;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		font-size: 1.75rem;
		font-weight: 600;
	}

	.prose :global(h3) {
		margin-top: 2rem;
		font-size: 1.375rem;
		font-weight: 600;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
	}

	.prose :global(li + li) {
		margin-top: 0.4rem;
	}

	.prose :global(a) {
		text-underline-offset: 0.2em;
	}

	.prose :global(blockquote) {
		margin-inline: 0;
		padding-left: 1.25rem;
		border-left: 1px solid var(--ink);
		color: var(--ink-soft);
	}

	.prose :global(code) {
		padding: 0.1em 0.3em;
		background: var(--paper);
		font-size: 0.9em;
	}

	.prose :global(pre) {
		padding: 1rem;
		overflow-x: auto;
		background: var(--paper);
		border: var(--rule);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.prose :global(pre code) {
		padding: 0;
		background: none;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	footer {
		margin-top: clamp(4rem, 9vw, 6rem);
		border-top: var(--rule);
		color: var(--ink-soft);
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding-block: 1.5rem 2rem;
		font-size: 0.9375rem;
	}

	.foot a {
		color: var(--ink);
		text-underline-offset: 0.3em;
	}
</style>
