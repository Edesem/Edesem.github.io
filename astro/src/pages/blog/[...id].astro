---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { formatDate, getPosts } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} · Edesem`} description={post.data.description}>
	<Header />
	<main class="column">
		<article>
			<header>
				<h1>{post.data.title}</h1>
				<p class="muted">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				</p>
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>
	</main>
</Layout>

<style>
	main {
		padding-block: clamp(2rem, 8vw, 4rem) 6rem;
	}

	h1 {
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		line-height: 1.25;
	}

	header p {
		margin-top: 0.5rem;
	}

	.prose {
		margin-top: 2.5rem;
	}

	.prose :global(> * + *) {
		margin-top: 1.1rem;
	}

	.prose :global(h2) {
		margin-top: 2.5rem;
		font-size: 1.375rem;
	}

	.prose :global(h3) {
		margin-top: 2rem;
		font-size: 1.125rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
	}

	.prose :global(ul) {
		list-style: disc;
	}

	.prose :global(ol) {
		list-style: decimal;
	}

	.prose :global(li + li) {
		margin-top: 0.4rem;
	}

	.prose :global(blockquote) {
		margin-inline: 0;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line);
		color: var(--muted);
	}

	.prose :global(code) {
		font-size: 0.9em;
		color: var(--text);
	}

	.prose :global(pre) {
		padding: 1rem;
		overflow-x: auto;
		border: 1px solid var(--line);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}
</style>
