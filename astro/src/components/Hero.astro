---
import { profile } from "../data/site";

const edition = new Date().toLocaleDateString("en-AU", { month: "short", year: "numeric" });
---

<section class="hero wrap" id="top">
	<h1>{profile.headline}</h1>
	<div class="foot">
		<p class="intro">{profile.intro}</p>
		<p class="stamp">
			<span class="role">{profile.role}</span>
			<span>Edition {edition}</span>
			<span>Subject to change</span>
		</p>
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
	}

	h1 {
		font-size: clamp(2.25rem, 5.2vw, 3.75rem);
		line-height: 1.08;
		max-width: 19em;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem 3rem;
		margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.intro {
		max-width: 38rem;
		color: var(--ink-soft);
		font-size: 1.125rem;
	}

	.stamp {
		display: grid;
		flex-shrink: 0;
		padding: 0.5rem 0.8rem;
		border: var(--rule);
		font-family: var(--font-cond);
		font-weight: 500;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.role {
		font-weight: 600;
		color: var(--ink);
	}
</style>
