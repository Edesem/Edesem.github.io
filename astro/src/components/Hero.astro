---
import { profile } from "../data/site";
---

<section class="hero">
	<h1>{profile.headline}</h1>
	<p class="muted">{profile.intro}</p>
</section>

<style>
	.hero {
		padding-top: clamp(3rem, 12vw, 7rem);
	}

	h1 {
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		line-height: 1.25;
	}

	p {
		margin-top: 1rem;
	}
</style>
