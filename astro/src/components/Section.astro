---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
	<h2 id={`${id}-title`} class="muted">{title}</h2>
	<slot />
</section>

<style>
	section {
		margin-top: clamp(3.5rem, 9vw, 5rem);
	}

	h2 {
		margin-bottom: 1.25rem;
		font-size: 1rem;
	}
</style>
